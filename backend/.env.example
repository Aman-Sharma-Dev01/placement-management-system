# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/placement-management

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_this
JWT_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Sign-In (OAuth 2.0 Web application Client ID)
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env
# No client secret is required for this flow.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Email (Nodemailer / SMTP) --------------------------------------------
# Everything here is BACKEND ONLY. Never put these in frontend/.env — Vite
# inlines anything prefixed with VITE_ into the shipped JS bundle.
#
# Gmail setup:
#   1. Enable 2-Step Verification on the Google account.
#   2. Generate an App Password at myaccount.google.com/apppasswords.
#      Use the 16-character app password, NOT the account password.
#   3. SMTP_USER = the full address, SMTP_PASSWORD = the app password.
#
# Without these the server still boots and every business flow works; emails
# are logged to EmailLog with status SKIPPED and /api/health reports
# email.configured = false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true only for implicit TLS (port 465). 587 uses STARTTLS.
SMTP_SECURE=false
SMTP_USER=usahelicopterforgames@gmail.com
SMTP_PASSWORD=qnya atxk mkgg pmuk
SMTP_FROM=placementcell@youruniversity.edu.in
SMTP_FROM_NAME=SuperSet Placement Portal
SMTP_POOL_SIZE=5
SMTP_TIMEOUT_MS=10000

# --- Branding / links used inside emails ----------------------------------
PORTAL_NAME=Superset Placement Portal
# Must match the Vite dev server port (3000) and the deployed frontend URL.
PORTAL_URL=http://localhost:3000
UNIVERSITY_NAME=Your University Placement Cell
SUPPORT_EMAIL=placementcell@youruniversity.edu.in

# --- Email delivery tuning ------------------------------------------------
EMAIL_MAX_ATTEMPTS=3
# Comma-separated backoff in ms between attempt 1, 2 and 3.
EMAIL_RETRY_DELAYS_MS=30000,120000
EMAIL_BATCH_SIZE=10
EMAIL_MAX_QUEUE=10000
EMAIL_FAILURE_ALERT_THRESHOLD=5

# --- Password reset -------------------------------------------------------
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_MAX_ACTIVE=3
PASSWORD_RESET_RATE_LIMIT_MAX=5

# --- Auth rate limiting ---------------------------------------------------
# Sign-in attempts. Successful logins refund their slot, so this caps failures
# only. Raise it on shared campus NAT if legitimate users get locked out.
AUTH_RATE_LIMIT_MAX=20
# Account creations per IP. Successful registrations still count, so this is a
# hard cap on how many accounts one network can create.
REGISTER_RATE_LIMIT_MAX=10

# --- Reminder scheduler ---------------------------------------------------
# Set to false to disable deadline/interview reminder emails entirely.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_TICK_MS=900000
